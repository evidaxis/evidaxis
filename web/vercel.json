{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "cleanUrls": false,
  "headers": [
    {
      "source": "/e/:entity_id/feed.:format(atom|json)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ],
  "redirects": [
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap-index.xml",
      "permanent": true
    },
    {
      "source": "/e/:entity_id/:slug((?!feed\\.(?:atom|json)$|(?:values|history)-[^/]+\\.csv$)[^/]+)",
      "destination": "/e/:entity_id/",
      "permanent": true
    },
    {
      "source": "/methodology",
      "destination": "/methodology/current/",
      "permanent": true
    },
    {
      "source": "/methodology/",
      "destination": "/methodology/current/",
      "permanent": true
    },
    {
      "source": "/cohorts/:taxon/:period",
      "destination": "/ai/cohorts/:taxon/",
      "permanent": true
    },
    {
      "source": "/cohorts/:taxon/:period/",
      "destination": "/ai/cohorts/:taxon/",
      "permanent": true
    },
    {
      "source": "/cohorts/:taxon",
      "destination": "/ai/cohorts/:taxon/",
      "permanent": true
    },
    {
      "source": "/cohorts/:taxon/",
      "destination": "/ai/cohorts/:taxon/",
      "permanent": true
    },
    {
      "source": "/rankings/ai-coding-agents/:period",
      "destination": "/ai/cohorts/coding-agents/",
      "permanent": true
    },
    {
      "source": "/rankings/ai-coding-agents/:period/",
      "destination": "/ai/cohorts/coding-agents/",
      "permanent": true
    },
    {
      "source": "/rankings/:taxon/:period",
      "destination": "/ai/cohorts/:taxon/",
      "permanent": true
    },
    {
      "source": "/rankings/:taxon/:period/",
      "destination": "/ai/cohorts/:taxon/",
      "permanent": true
    },
    {
      "source": "/rankings/:taxon",
      "destination": "/ai/cohorts/:taxon/",
      "permanent": true
    },
    {
      "source": "/rankings/:taxon/",
      "destination": "/ai/cohorts/:taxon/",
      "permanent": true
    }
  ]
}
