---
import NicheHub from '../../../../../components/hubs/NicheHub.astro';
import { industries, entitiesInCohort } from '../../../../../lib/data';
import { pageCount } from '../../../../../lib/pagination';

export function getStaticPaths() {
  const out: any[] = [];
  for (const field of industries().values()) for (const cohort of field.subniches.values()) {
    const totalPages = pageCount(entitiesInCohort(cohort.cohortKey).length);
    for (let page = 2; page <= totalPages; page += 1) {
      out.push({ params: { cohort: cohort.slug, page: String(page) }, props: { cohortKey: cohort.cohortKey, page } });
    }
  }
  return out;
}
const { cohortKey, page } = Astro.props;
---
<NicheHub cohortKey={cohortKey} page={page} />
