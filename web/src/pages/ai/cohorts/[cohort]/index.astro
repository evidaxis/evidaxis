---
import NicheHub from '../../../../components/hubs/NicheHub.astro';
import { industries } from '../../../../lib/data';

export function getStaticPaths() {
  const out: any[] = [];
  for (const f of industries().values())
    for (const c of f.subniches.values())
      out.push({ params: { cohort: c.slug }, props: { cohortKey: c.cohortKey } });
  return out;
}
const { cohortKey } = Astro.props;
---
<NicheHub cohortKey={cohortKey} page={1} />
