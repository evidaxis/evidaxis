---
import Base from '../../../../layouts/Base.astro';
import NicheCard from '../../../../components/hubs/NicheCard.astro';
import { industries } from '../../../../lib/data';
import { breadcrumb } from '../../../../lib/jsonld';
import { SITE, UNASSIGNED, nicheSummary } from '../../../../lib/hubs';

export function getStaticPaths() {
  return [...industries().values()].map((f) => ({
    params: { field: f.slug },
    props: { slug: f.slug, label: f.label, cohortKeys: [...f.subniches.values()].map((c) => c.cohortKey) },
  }));
}
const { slug, label, cohortKeys } = Astro.props;
const niches = cohortKeys.map((key: string) => nicheSummary(key))
  .sort((a, b) => a.label.localeCompare(b.label, 'en', { sensitivity: 'base' }));
const unassignedOnly = niches.length > 0 && niches.every((s) => s.key === UNASSIGNED);
const systems = niches.reduce((sum, s) => sum + s.n, 0);
const count = (n: number, one: string, many: string) => `${n.toLocaleString('en-US')} ${n === 1 ? one : many}`;
const heading = unassignedOnly ? 'Not yet assigned' : label;
const answer = unassignedOnly
  ? `${count(systems, 'system is', 'systems are')} measured every week but ${systems === 1 ? 'has' : 'have'} no niche yet, so there is no niche median, no medal and no niche Rising comparison.`
  : `${label} is ${count(niches.length, 'niche', 'niches')} and ${count(systems, 'system', 'systems')}. Each niche keeps its own median; medals and Rising are computed inside a niche, so this page does not merge systems into one list.`;
const title = unassignedOnly
  ? `Not yet assigned: ${systems.toLocaleString('en-US')} open AI systems measured weekly | Evidaxis`
  : `${label}: ${count(niches.length, 'niche', 'niches')} and ${count(systems, 'open-source AI system', 'open-source AI systems')} measured weekly | Evidaxis`;
const desc = unassignedOnly
  ? `${count(systems, 'open AI system', 'open AI systems')} measured weekly with no niche yet: commits, citations and dependents per system. CC0 open data.`
  : `${label}: ${count(niches.length, 'niche', 'niches')} and ${count(systems, 'system', 'systems')}. Niche medians for commits, citations and dependents, medals and Rising, per niche. CC0.`;
const path = `/ai/fields/${slug}/`;
const crumbs = [{ name: 'Home', path: '/' }, { name: heading, path }];
const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'CollectionPage', '@id': `${SITE}${path}#page`, url: `${SITE}${path}`, name: heading, description: answer,
      inLanguage: 'en', isPartOf: { '@id': `${SITE}/#website` }, mainEntity: { '@id': `${SITE}${path}#niches` } },
    { '@type': 'ItemList', '@id': `${SITE}${path}#niches`, name: `${heading}: niches, name A to Z`, itemListOrder: 'https://schema.org/ItemListOrderAscending',
      numberOfItems: niches.length, itemListElement: niches.map((s) => ({ '@type': 'ListItem', name: s.label, url: `${SITE}/ai/cohorts/${s.slug}/` })) },
  ],
};
---
<Base title={title} description={desc} canonical={path} jsonLd={[graph, breadcrumb(crumbs)]}>
  <section class="section field">
    <div class="wrap">
      <nav class="crumb mono muted" aria-label="Breadcrumb"><a href="/">Home</a> / <span>{heading}</span></nav>
      <p class="eyebrow">Field</p>
      <h1>{heading}</h1>
      <p class="field-answer">{answer}</p>
      {!unassignedOnly && <p class="field-order mono">Niche name, A to Z</p>}
      <div class="field-grid">
        {niches.map((s) => <NicheCard summary={s} />)}
      </div>
      <p class="field-how"><a href="/glossary/#terms-on-every-page">How each figure is computed →</a></p>
    </div>
  </section>
</Base>

<style>
  .field .crumb { font-size: .74rem; margin-bottom: .8rem; }
  .field .crumb a { color: inherit; border: none; }
  .field-answer { font-size: 1.08rem; line-height: 1.6; color: var(--ink-soft); max-width: 72ch; margin: 1rem 0 0; }
  .field-order { margin: 1.8rem 0 .7rem; font-size: .76rem; color: var(--ink-mute); }
  .field-answer + .field-grid { margin-top: 1.8rem; }
  .field-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 16px; }
  .field-how { margin-top: 1.6rem; font-size: .92rem; }
</style>
