---
import Base from '../../layouts/Base.astro';
import { breadcrumb } from '../../lib/jsonld';
import { snapshot } from '../../lib/data';
import { ALL_TERMS, GLOSSARY_SECTIONS } from '../../lib/glossary';

const SITE = 'https://evidaxis.org';

const desc = 'The Evidaxis glossary: system, niche, niche median, niche medal and Rising in plain words, then momentum, the convergence gate and the axes.';

const definedTermSet = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTermSet',
  '@id': `${SITE}/glossary/#terms`,
  name: 'Evidaxis vocabulary',
  description: 'The defined terms of the Evidaxis measurement methodology.',
  url: `${SITE}/glossary/`,
  hasDefinedTerm: ALL_TERMS.map((t) => ({
    '@type': 'DefinedTerm',
    '@id': `${SITE}/glossary/#${t.id}`,
    name: t.name,
    description: t.def,
    inDefinedTermSet: `${SITE}/glossary/#terms`,
  })),
};
const crumbs = breadcrumb([{ name: 'Methodology', path: '/methodology/current/' }, { name: 'Glossary', path: '/glossary/' }]);
---
<Base title="Glossary, Evidaxis" description={desc} canonical="/glossary/" jsonLd={[definedTermSet, crumbs]}>
  <section class="section">
    <div class="wrap prose">
      <p class="eyebrow">Methodology · vocabulary</p>
      <h1>Glossary</h1>
      <p class="lead">These terms describe Evidaxis measurements. The latest published snapshot uses {snapshot.methodology_version}; historical records retain their own methodology. Each definition names the signal, window, and threshold used to interpret the open data.</p>
      <nav class="mono" aria-label="Glossary sections" style="font-size:.8rem;margin-top:1.2rem">
        {GLOSSARY_SECTIONS.map((section, i) => <>{i > 0 && ' · '}<a href={`#${section.id}`}>{section.title}</a></>)}
      </nav>
      {GLOSSARY_SECTIONS.map((section) => (
        <section id={section.id} style="margin-top:2.4rem">
          <h2>{section.title}</h2>
          <dl style="margin-top:1.4rem">
            {section.terms.map((t) => (
              <div id={t.id} style="margin-bottom:1.6rem;padding-bottom:1.2rem;border-bottom:1px solid var(--hairline)">
                <dt style="font-family:var(--font-display);font-weight:600;font-size:1.18rem;color:var(--ink)">{t.name}</dt>
                <dd style="margin:.4rem 0 0;max-width:64ch">{t.def}</dd>
              </div>
            ))}
          </dl>
        </section>
      ))}
      <p class="muted"><a href="/methodology/current/">Full methodology →</a></p>
    </div>
  </section>
</Base>
