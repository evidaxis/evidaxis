---
import Base from '../../layouts/Base.astro';
import Scatter from '../../components/charts/Scatter.astro';
import Beeswarm from '../../components/charts/Beeswarm.astro';
import Donut from '../../components/charts/Donut.astro';
import { snapshot, industries, entitiesInCohort, SNAP_DATE } from '../../lib/data';
import { itemListDataset, breadcrumb } from '../../lib/jsonld';
import { measurementStateFor } from '../../lib/measurement';
import { computePowerFunnel } from '../../lib/power';
import { AXIS3_ESTIMAND, DEVELOPMENT_AXIS, CITATION_AXIS, DEPENDENTS_AXIS, methodologyAxes } from '../../lib/methodology';
import { pageCount, pageItems } from '../../lib/pagination';
import Pagination from '../../components/Pagination.astro';
const inds = [...industries().values()];
const allCohorts = inds.flatMap((ind) => [...ind.subniches.values()].map((sn) => ({ ind, sn })));
const orderedSystems = allCohorts.flatMap(({ sn }) => entitiesInCohort(sn.cohortKey));
const totalPages = pageCount(orderedSystems.length);
const visible = pageItems(orderedSystems, 1);
const visibleIds = totalPages === 1 ? null : new Set(visible.map((entity) => entity.entity_id));
const power = computePowerFunnel(snapshot);
const isM3 = methodologyAxes(snapshot.methodology_version).length === 3;
const desc = `Evidaxis coverage atlas: ${snapshot.counts.entities} AI systems across ${allCohorts.length} cohorts, plus an explicit map of what is not yet measured.`;
const listJson = itemListDataset({ path: '/coverage/', name: 'Evidaxis coverage atlas', description: desc, snap: snapshot, entities: totalPages === 1 ? snapshot.entities : visible });
---
<Base title="Coverage atlas | Evidaxis" description={desc} canonical="/coverage/" jsonLd={[listJson, breadcrumb([{ name: 'Coverage', path: '/coverage/' }])]}>
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Coverage atlas · Epoch 01</p>
      <h1>{snapshot.counts.entities} systems. {allCohorts.length} cohorts. One longitudinal map.</h1>
      <p class="lead" style="max-width:62ch">You cannot catch a flare without the baseline that came before it. So we record the frontier wide and early, every score frozen, with hash-pinned inputs and open raw provenance. Absence here means one thing: no baseline yet. The instrument is the coverage, and the coverage is what compounds.</p>

      <!-- Chart wall (moved from homepage WP-J): content-visibility defers offscreen paint. -->
      {totalPages === 1 && <div class="chart-wall" style="margin-top:2.4rem">
        <h2 style="font-size:1.2rem;margin:0 0 1rem">Snapshot chart wall · {snapshot.snapshot_id}</h2>
        <div class="wall-grid">
          <div class="wall-panel">
            <div class="wall-ttl mono">Convergence scatter</div>
            <Scatter />
          </div>
          <div class="wall-panel">
            <div class="wall-ttl mono">Momentum by cohort</div>
            <Beeswarm />
          </div>
          {isM3 && <>
            <div class="wall-panel"><div class="wall-ttl mono">Development and direct dependents</div><Scatter xAxis={DEVELOPMENT_AXIS} yAxis={DEPENDENTS_AXIS} /></div>
            <div class="wall-panel"><div class="wall-ttl mono">Citations and direct dependents</div><Scatter xAxis={CITATION_AXIS} yAxis={DEPENDENTS_AXIS} /></div>
          </>}
        </div>
        <div class="donut-pair" style="margin-top:1.4rem">
          <div class="donut-card">
            <Donut numerator={power.rising_published} denominator={power.gate_eligible} label="published Rising" />
            <div class="cap mono">published positive signals<br />from gate-eligible systems</div>
          </div>
          <div class="donut-card">
            <Donut numerator={power.two_axis_measurable} denominator={power.history_sufficient} label="axis coverage" color="var(--citation)" />
            <div class="cap mono">have at least two<br />measurable axes{isM3 && <> · {power.three_axis_measurable} have three</>}</div>
          </div>
        </div>
      </div>}

      <div class="stack" style="margin-top:2.4rem">
        {allCohorts.map(({ ind, sn }) => {
          const cohortEntities = entitiesInCohort(sn.cohortKey);
          const es = visibleIds ? cohortEntities.filter((entity) => visibleIds.has(entity.entity_id)) : cohortEntities;
          if (es.length === 0) return null;
          const withCite = es.filter((e) => measurementStateFor(e, snapshot).axis_coverage.axes.openalex_citation_momentum === 'measurable').length;
          return (
            <div class="panel" style="padding:20px 22px">
              <div class="row" style="justify-content:space-between;align-items:baseline">
                <h2 style="margin:0;font-size:1.12rem"><a href={`/ai/cohorts/${sn.slug}/`} style="border:none">{sn.label}</a></h2>
                <span class="mono muted" style="font-size:.74rem">{ind.label} · {es.length} systems · {withCite} with citation axis{isM3 && <> · {es.filter(e => e.axes.deps_direct_dependents_momentum?.status === 'scored').length} with direct-dependents axis</>}</span>
              </div>
              <div class="row" style="margin-top:.9rem;gap:8px">
                {es.map((e) => (
                  <a href={`/e/${e.entity_id}/`} class={`system-link ${measurementStateFor(e, snapshot).positive_signal.state === 'published' ? 'positive-signal' : ''}`}>{e.name}</a>
                ))}
              </div>
            </div>
          );
        })}
      </div>{totalPages > 1 && <Pagination page={1} totalPages={totalPages} basePath="/coverage/" />}

      <div class="panel" style="padding:22px;margin-top:2rem;border-left:3px solid var(--citation)">
        <div class="eyebrow" style="color:var(--citation-ink)">Known gaps</div>
        <ul class="prose" style="margin-top:.7rem;margin-bottom:0">
          <li><strong>Closed-source systems.</strong> Private SaaS leaves few public, hard-to-game signals; this pilot tracks OSS / research-native systems where the data is rich and tamper-resistant.</li>
          <li><strong>Systems without a paper.</strong> Where no academic source is configured, citation-source availability is recorded as <span class="mono">source_not_measured</span>.</li>
          {isM3 && <li><strong>Frozen package panel.</strong> {AXIS3_ESTIMAND}</li>}
          <li><strong>New systems.</strong> Weekly history is reported as an exact count against the four-observation minimum. Each weekly snapshot adds one observation.</li>
          <li><strong>Beyond AI.</strong> The taxonomy reserves room beyond AI; this pilot measures three AI frontiers only.</li>
        </ul>
      </div>
      <p class="lead" style="max-width:62ch;margin-top:2rem">The record gets stronger the longer it runs. Only a continuous baseline can catch a flare against its own past, and ours starts here.</p>
      <p class="muted" style="margin-top:1rem"><a href="/coverage/power/">See the measurement power funnel →</a></p>
      <p class="muted" style="margin-top:1.4rem"><a href={`/snapshots/${SNAP_DATE}/`}>See the full snapshot →</a></p>
    </div>
  </section>
</Base>

<style>
  .chart-wall { content-visibility: auto; contain-intrinsic-size: auto 720px; }
  .wall-grid { display: grid; grid-template-columns: 1.2fr 1fr; gap: 28px; align-items: start; }
  .wall-panel { background: var(--surface); border: 1px solid var(--hairline); border-radius: 12px; padding: 16px 18px; box-shadow: var(--shadow-card); }
  .wall-ttl { font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--ink-mute); margin-bottom: 12px; }
  .donut-pair { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; max-width: 420px; }
  .donut-card { background: var(--surface); border: 1px solid var(--hairline); border-radius: 12px; padding: 18px 14px; text-align: center; box-shadow: var(--shadow-card); }
  .donut-card .cap { font-size: 11px; color: var(--ink-mute); margin-top: 10px; line-height: 1.45; }
  .system-link { border: 1px solid var(--hairline); border-radius: 5px; padding: 3px 8px; font-family: var(--font-mono); font-size: 10px; color: var(--ink-soft); }
  .system-link.positive-signal { border-color: var(--velocity); color: var(--velocity-ink); }
  @media (max-width: 860px) {
    .wall-grid { grid-template-columns: 1fr; }
    .donut-pair { max-width: none; }
  }
</style>
