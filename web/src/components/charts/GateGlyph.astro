---
/** Each version's axes feed the same any-two gate; unavailable axes stay explicit. */
import { snapshot as latestSnapshot, AXIS_LABEL } from '../../lib/data';
import type { Entity, Snapshot } from '../../lib/data';
import { measurementPhrases, measurementStateFor } from '../../lib/measurement';
import { methodologyAxes } from '../../lib/methodology';
import { stableDomId } from '../../lib/charts';

export interface Props { entity: Entity; snapshot?: Snapshot; width?: number; height?: number }
const { entity, snapshot = latestSnapshot, width = 110, height = 56 } = Astro.props;
const axes = methodologyAxes(snapshot.methodology_version);
const state = measurementStateFor(entity, snapshot);
const conv = entity.convergent_axes ?? [];
const phrase = measurementPhrases(state).gate;
const gateX = width * 0.62, gap = width * 0.07, startX = width * 0.07;
const colors = ['var(--velocity)', 'var(--citation)', 'var(--ink-soft)'];
const titleId = stableDomId('gg-t', entity.entity_id, snapshot.methodology_version, width, height);
function arrowEnd(pass: boolean) { return pass ? gateX - 2 : gateX - 14; }
---
<figure class="evchart" style="margin:0;display:flex;flex-direction:column;align-items:center;gap:4px">
  <svg width={width} height={height} viewBox={`0 0 ${width} ${height}`} role="img" aria-labelledby={titleId}>
    <title id={titleId}>Convergence gate: {phrase}</title>
    <line x1={gateX} y1={height * 0.12} x2={gateX} y2={height * 0.88} stroke="var(--ink-mute)" stroke-width="2" stroke-linecap="round" />
    <line x1={gateX + gap} y1={height * 0.12} x2={gateX + gap} y2={height * 0.88} stroke="var(--ink-mute)" stroke-width="2" stroke-linecap="round" />
    {axes.map((axis, i) => {
      const y = height * (0.18 + 0.64 * (i + 0.5) / axes.length);
      const pass = conv.includes(axis);
      const measured = state.axis_coverage.axes[axis] === 'measurable';
      const color = pass ? colors[i] : 'var(--hairline-2)';
      return <g>
        <title>{AXIS_LABEL[axis]}: {pass ? 'rising vote' : measured ? 'measured' : 'not measurable'}</title>
        <line x1={startX} y1={y} x2={arrowEnd(pass)} y2={y} stroke={color} stroke-width="2.2" stroke-linecap="round" stroke-dasharray={pass ? '' : '3 3'} />
        <path d={`M${arrowEnd(pass) - 5} ${y - 4} L${arrowEnd(pass)} ${y} L${arrowEnd(pass) - 5} ${y + 4}`} fill="none" stroke={color} stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
        {pass ? <>
          <line x1={gateX + gap} y1={y} x2={width - 6} y2={y} stroke={color} stroke-width="2.2" stroke-linecap="round" />
          <path d={`M${width - 11} ${y - 4} L${width - 6} ${y} L${width - 11} ${y + 4}`} fill="none" stroke={color} stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
        </> : <text x={gateX - 9} y={y + 3} text-anchor="end" font-size="9" fill="var(--hairline-2)" font-weight="700" class="svgtxt">{measured ? '×' : '∅'}</text>}
      </g>;
    })}
  </svg>
  <figcaption class="chart-cap">
    <dl class="chart-dl" style="justify-content:center">
      <div><dt>gate</dt><dd><data value={String(conv.length)}>{conv.length}</data> of {axes.length} axes</dd></div>
    </dl>
    <p class="chart-verdict" style="text-align:center">{phrase}</p>
  </figcaption>
</figure>
