---
/**
 * Convergence scatter over ALL entities.
 *   x and y = the selected pair's cohort_z (velocity/citation by default),
 *   r = momentum, ring if status === 'rising', color by cohort.
 * Pair wash follows the version's z floor; rings show the full any-two gate.
 * Null z-scores are EXCLUDED from the plane (never plotted at 0 = median).
 * Entities missing the vertical axis sit on a dedicated lower rail (honest).
 * "Rising" captions count only status === 'rising' (full gate predicate).
 */
import { scaleLinear, stableDomId } from '../../lib/charts';
import { entities as allEntities, snapshot as latestSnapshot, risingZFloor, AXIS_LABEL } from '../../lib/data';
import type { Entity, Snapshot } from '../../lib/data';
import { DEVELOPMENT_AXIS, CITATION_AXIS, DEPENDENTS_AXIS, methodologyAxes, type AxisKey } from '../../lib/methodology';
import { cohortColor, cohortLabel, COHORT_ORDER } from '../../lib/cohorts';
import { measurementStateFor } from '../../lib/measurement';

export interface Props {
  entities?: Entity[];
  snapshot?: Snapshot;
  xAxis?: AxisKey;
  yAxis?: AxisKey;
  width?: number;
  height?: number;
  dom?: number;            // axis half-domain in z (default 2)
}
const { entities = allEntities, snapshot = latestSnapshot, xAxis = DEVELOPMENT_AXIS, yAxis = CITATION_AXIS, width = 560, height = 420, dom = 2 } = Astro.props;
const axes = methodologyAxes(snapshot.methodology_version);
if (!axes.includes(xAxis) || !axes.includes(yAxis) || xAxis === yAxis) throw new Error('invalid scatter axis pair');
const axisZ = (e: Entity, key: AxisKey) => key === DEPENDENTS_AXIS && e.axes[key]?.status !== 'scored' ? null : e.axes[key]?.cohort_z ?? null;
const xLabel = AXIS_LABEL[xAxis], yLabel = AXIS_LABEL[yAxis];

const zFloor = risingZFloor(snapshot.methodology_version);

const m = { t: 22, r: 22, b: 56, l: 52 };
const iw = width - m.l - m.r;
const ih = height - m.t - m.b;
const railH = 24;          // unavailable vertical axis stays below the plane
const planeH = ih - railH;

const sx = scaleLinear([-dom, dom], [m.l, m.l + iw]);
const sy = scaleLinear([-dom, dom], [m.t + planeH, m.t]);

const x0 = sx(0), y0 = sy(0);
// Gate wash origin: methodology z floor, not the cohort median.
const xGate = sx(zFloor), yGate = sy(zFloor);
const momenta = entities.map((e) => e.momentum ?? 0);
const maxMom = Math.max(1, ...momenta);
const rOf = (mom: number | null) => 4 + 7 * Math.sqrt((mom ?? 0) / maxMom);

// Dual-axis plane: BOTH z-scores must be present. Null never coerced to 0.
const withCit = entities.filter((e) =>
  axisZ(e, xAxis) != null && axisZ(e, yAxis) != null);
// A single horizontal coordinate belongs on the rail, never at median y.
// Review 2026-07-10: both-axes-null entities are EXCLUDED entirely (no rail spot).
const noCit = entities.filter((e) =>
  axisZ(e, yAxis) == null && axisZ(e, xAxis) != null);
const nullVel = entities.filter((e) =>
  axisZ(e, xAxis) == null && axisZ(e, yAxis) != null);
// Full gate predicate only (status is the pipeline's convergent_axes + cohort + floors).
const risingCount = entities.filter((e) => measurementStateFor(e, snapshot).positive_signal.state === 'published').length;
const ticks = [-2, -1, 1, 2];
const domId = stableDomId('sc', entities.map((entity) => entity.entity_id), xAxis, yAxis, width, height, dom);
const titleId = `${domId}-t`;
const descId = `${domId}-d`;

const cohortCount = (key: string) => entities.filter((e) => e.cohort === key).length;
const gateLabel = `${axes.length === 3 ? 'PAIR' : 'RISING'} z>=${zFloor}`;
const washW = Math.max(0, (m.l + iw) - xGate);
const washH = Math.max(0, yGate - m.t);
---
<figure class="evchart">
  <svg width={width} height={height} viewBox={`0 0 ${width} ${height}`} role="img" aria-labelledby={`${titleId} ${descId}`}>
    <title id={titleId}>Convergence scatter, {xLabel} z by {yLabel} z</title>
    <desc id={descId}>
      {withCit.length} systems plotted by {xLabel} z (horizontal) and {yLabel} z (vertical).
      The wash starts at z = {zFloor} for this pair (methodology {snapshot.methodology_version}).
      {risingCount} pass the full Rising gate across {axes.length} axes; rings show that full gate independently of the selected pair.
      {noCit.length} have only the horizontal coordinate and sit on the lower rail.
      {nullVel.length} have only the vertical coordinate and are excluded from the plane.
    </desc>

    {/* rising gate wash (both z >= methodology floor, not median) */}
    {washW > 0 && washH > 0 && (
      <rect x={xGate} y={m.t} width={washW} height={washH} class="rise-wash" />
    )}

    {/* median axes (reference) + gate threshold lines */}
    <line x1={x0} y1={m.t} x2={x0} y2={m.t + planeH} stroke="var(--grid)" stroke-width="1" />
    <line x1={m.l} y1={y0} x2={m.l + iw} y2={y0} stroke="var(--grid)" stroke-width="1" />
    {zFloor > 0 && (
      <>
        <line x1={xGate} y1={m.t} x2={xGate} y2={m.t + planeH} stroke="var(--velocity)" stroke-width="0.9" stroke-dasharray="3 2" opacity="0.55" />
        <line x1={m.l} y1={yGate} x2={m.l + iw} y2={yGate} stroke="var(--velocity)" stroke-width="0.9" stroke-dasharray="3 2" opacity="0.55" />
      </>
    )}

    {/* gridlines at +/-1, +/-2 */}
    {ticks.map((g) => (
      <>
        <line x1={sx(g)} y1={m.t} x2={sx(g)} y2={m.t + planeH} stroke="var(--hairline)" stroke-width="0.8" stroke-dasharray="2 3" />
        <line x1={m.l} y1={sy(g)} x2={m.l + iw} y2={sy(g)} stroke="var(--hairline)" stroke-width="0.8" stroke-dasharray="2 3" />
        <text x={sx(g)} y={m.t + planeH + 11} text-anchor="middle" font-size="7" fill="var(--ink-mute)" class="svgtxt">{g > 0 ? '+' : ''}{g}</text>
        <text x={m.l - 6} y={sy(g) + 2.5} text-anchor="end" font-size="7" fill="var(--ink-mute)" class="svgtxt">{g > 0 ? '+' : ''}{g}</text>
      </>
    ))}

    {/* rising-gate label */}
    <text x={m.l + iw - 4} y={m.t + 11} text-anchor="end" font-size="8.5" fill="var(--velocity)" letter-spacing=".06em" class="svgtxt">
      {gateLabel}
    </text>
    <text x={m.l + 4} y={m.t + planeH - 4} font-size="7" fill="var(--ink-mute)" class="svgtxt">cohort median</text>

    {/* axis titles */}
    <text x={m.l + iw} y={m.t + planeH + 26} text-anchor="end" font-size="8.5" fill="var(--ink-soft)" class="svgtxt">{xLabel} z &rarr;</text>
    <text transform={`rotate(-90)`} x={-(m.t)} y={11} text-anchor="end" font-size="8.5" fill="var(--ink-soft)" class="svgtxt">{yLabel} z &uarr;</text>

    {/* dual-axis points (both z present; no ?? 0) */}
    {withCit.map((e) => {
      const vz = axisZ(e, xAxis) as number;
      const cz = axisZ(e, yAxis) as number;
      const px = sx(Math.max(-dom, Math.min(dom, vz)));
      const py = sy(Math.max(-dom, Math.min(dom, cz)));
      const c = cohortColor(e.cohort);
      const rr = rOf(e.momentum);
      return (
        <>
          {measurementStateFor(e, snapshot).positive_signal.state === 'published' && <circle cx={px} cy={py} r={rr + 4} fill="none" stroke={c} stroke-width="1.3" opacity="0.45" />}
          <circle cx={px} cy={py} r={rr} fill={c} fill-opacity="0.9" stroke="var(--surface)" stroke-width="1.3" />
        </>
      );
    })}

    {/* Missing vertical coordinates stay off the plane. */}
    <line x1={m.l} y1={m.t + planeH + railH - 1} x2={m.l + iw} y2={m.t + planeH + railH - 1} stroke="var(--hairline-2)" stroke-width="0.8" stroke-dasharray="1 3" />
    <text x={m.l} y={m.t + planeH + railH + 9} font-size="7" fill="var(--ink-mute)" class="svgtxt">vertical axis unavailable ({noCit.length})</text>
    {noCit.map((e) => {
      const vz = axisZ(e, xAxis);
      if (vz == null) return null; // a rail spot still needs a horizontal coordinate
      const px = sx(Math.max(-dom, Math.min(dom, vz)));
      const py = m.t + planeH + railH / 2;
      const c = cohortColor(e.cohort);
      return (
        <>
          {measurementStateFor(e, snapshot).positive_signal.state === 'published' && <circle cx={px} cy={py} r={rOf(e.momentum) + 4} fill="none" stroke={c} stroke-width="1.3" opacity="0.45" />}
          <circle cx={px} cy={py} r={rOf(e.momentum)} fill={c} fill-opacity="0.32" stroke={c} stroke-width="1" stroke-dasharray="2 2" />
        </>
      );
    })}
  </svg>

  <figcaption class="chart-cap">
    <dl class="chart-dl">
      <div><dt>systems</dt><dd><data value={String(entities.length)}>{entities.length}</data></dd></div>
      <div><dt class="teal">rising (full gate)</dt><dd class="teal"><data value={String(risingCount)}>{risingCount}</data></dd></div>
      <div><dt>pair measured</dt><dd><data value={String(withCit.length)}>{withCit.length}</data></dd></div>
      <div><dt>horizontal only</dt><dd><data value={String(noCit.length)}>{noCit.length}</data></dd></div>
      <div><dt>not plotted</dt><dd>{entities.length - withCit.length - noCit.length}</dd></div>
      {COHORT_ORDER.map((k) => (
        <div><dt class={`c${COHORT_ORDER.indexOf(k) + 1}`}>{cohortLabel(k)}</dt><dd><data value={String(cohortCount(k))}>{cohortCount(k)}</data></dd></div>
      ))}
    </dl>
  </figcaption>

  {/* Full per-entity rows live on the snapshot JSON twin + RankTable; no duplicate table here (V4). */}
</figure>
