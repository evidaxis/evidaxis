---
import type { MeasurementState } from '../lib/measurement';
import { measurementPhrases } from '../lib/measurement';
export interface Props { state: MeasurementState; }
const { state } = Astro.props;
const phrases = measurementPhrases(state);
---
{state.positive_signal.state === 'published'
  ? <span class="badge rising">Rising</span>
  : <span class="mono muted" style="font-size:.72rem">{phrases.compact}</span>}
