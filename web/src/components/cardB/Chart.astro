---
import { CHARTS_INLINE } from '../../lib/cardB/config';
import type { Chart } from '../../lib/cardB/charts';
import Sentence from './Sentence.astro';
export interface Props { chart?: Chart }
const { chart } = Astro.props;
---
{chart && <figure class="card-b-chart">
  {CHARTS_INLINE ? <Fragment set:html={chart.svg} /> : <img src={chart.url} alt={chart.alt} width="640" height="200" loading="lazy" />}
  <figcaption data-claim={chart.claim}><Sentence text={chart.title} />{' '}{chart.source} · <time datetime={chart.date}>{chart.date}</time>.</figcaption>
</figure>}
