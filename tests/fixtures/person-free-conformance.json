{
  "schema": "person_free_conformance_1",
  "cases": [
    {
      "id": "live-organization-gives-one-repository",
      "registry": {
        "zz-drill-lab/kept": {"owner_type": "Organization", "repo_id": 1, "full_name": "zz-drill-lab/kept"},
        "zz-drill-lab/given": {"owner_type": "User", "repo_id": 2, "full_name": "zz-drill-person/given"}
      },
      "floor": ["ZZ-DRILL-LAB"],
      "expected": {"handles": ["zz-drill-person"], "stalePaths": ["zz-drill-lab/given"], "publicRepos": ["zz-drill-lab/kept"]},
      "probes": [
        {"text": "zz-drill-lab is public", "hits": []},
        {"text": "github.com%252Fzz-drill-person%252Fgiven", "hits": ["zz-drill-person"]}
      ],
      "diagnostics": [
        {"path": "zz-drill-lab/given/page.json", "rule": "f", "value": "zz-drill-person", "privatePath": true},
        {"path": "zz-drill-lab%252Fgiven/page.json", "rule": "f", "value": "zz-drill-person", "privatePath": true},
        {"path": "zz-drill-lab/kept/page.json", "rule": "f", "value": "zz-drill-person", "privatePath": false},
        {"path": "zz-drill-lab/given/page.json", "rule": "d", "value": "zz-drill-lab/given", "privatePath": true}
      ],
      "projection": {"repo": "zz-drill-lab/given", "homepage": "https://zz-drill-lab.github.io/project", "expectedHomepage": "https://zz-drill-lab.github.io/project"}
    },
    {
      "id": "person-to-person-former-homepage",
      "registry": {"zz-drill-former/tool": {"owner_type": "User", "repo_id": 3, "full_name": "zz-drill-current/tool"}},
      "expected": {"handles": ["zz-drill-current", "zz-drill-former"], "stalePaths": ["zz-drill-former/tool"], "publicRepos": []},
      "probes": [{"text": "ZZ-DRILL-FORMER", "hits": ["zz-drill-former"]}],
      "projection": {"repo": "zz-drill-former/tool", "homepage": "https://zz-drill-former.github.io/project", "expectedHomepage": null}
    },
    {
      "id": "organization-rename-former-type-unknown",
      "registry": {"zz-drill-oldlab/tool": {"owner_type": "Organization", "repo_id": 4, "full_name": "zz-drill-newlab/tool"}},
      "expected": {"handles": ["zz-drill-oldlab"], "stalePaths": ["zz-drill-oldlab/tool"], "publicRepos": ["zz-drill-oldlab/tool"]},
      "projection": {"repo": "zz-drill-oldlab/tool", "homepage": "https://zz-drill-oldlab.github.io/project", "expectedHomepage": null}
    },
    {
      "id": "live-organization-to-organization",
      "registry": {
        "zz-drill-oldlab/kept": {"owner_type": "Organization", "repo_id": 5, "full_name": "zz-drill-oldlab/kept"},
        "zz-drill-oldlab/tool": {"owner_type": "Organization", "repo_id": 6, "full_name": "zz-drill-newlab/tool"}
      },
      "expected": {"handles": [], "stalePaths": [], "publicRepos": ["zz-drill-oldlab/kept", "zz-drill-oldlab/tool"]},
      "projection": {"repo": "zz-drill-oldlab/tool", "homepage": "https://zz-drill-oldlab.github.io/project", "expectedHomepage": "https://zz-drill-oldlab.github.io/project"}
    },
    {
      "id": "project-account-exception",
      "registry": {
        "zz-drill-former/tool": {"owner_type": "User", "repo_id": 7, "full_name": "ZZ-DRILL-PROJECT/tool"},
        "zz-drill-project/other": {"owner_type": "User", "repo_id": 8, "full_name": "zz-drill-project/other"}
      },
      "accounts": {"zz-drill-project": {}},
      "floor": ["zz-drill-project", "zz-drill-floor"],
      "expected": {"handles": ["zz-drill-floor", "zz-drill-former"], "stalePaths": ["zz-drill-former/tool"], "publicRepos": ["zz-drill-former/tool", "zz-drill-project/other"]}
    },
    {
      "id": "same-owner-rename-case-and-short-logins",
      "registry": {
        "Q7/old": {"owner_type": "User", "repo_id": 9, "full_name": "q7/new"},
        "7890/tool": {"owner_type": "User", "repo_id": 10, "full_name": "7890/tool"}
      },
      "expected": {"handles": ["7890", "q7"], "stalePaths": [], "publicRepos": []},
      "probes": [
        {"text": "q7 and 7890 systems /q7/ /7890/", "hits": []},
        {"text": "https://q7.github.io github.com/7890", "hits": ["7890", "q7"]},
        {"text": "@q7", "hits": ["q7"]},
        {"text": "widget-q7-plugin widget-7890-plugin", "hits": []}
      ]
    },
    {
      "id": "template-word-only-in-context",
      "registry": {"system/tool": {"owner_type": "User", "repo_id": 11, "full_name": "system/tool"}},
      "templateWords": ["system"],
      "expected": {"handles": ["system"], "stalePaths": [], "publicRepos": []},
      "probes": [
        {"text": "System /system/tool system", "hits": []},
        {"text": "github.com/system/tool", "hits": ["system"]},
        {"text": "https://system.github.io/project", "hits": ["system"]},
        {"text": "@system", "hits": ["system"]}
      ],
      "projection": {"repo": "system/tool", "homepage": "https://system.example/", "expectedHomepage": null}
    },
    {
      "id": "floor-survives-departure",
      "registry": {},
      "floor": ["ZZ-DRILL-FLOOR"],
      "expected": {"handles": ["zz-drill-floor"], "stalePaths": [], "publicRepos": []},
      "probes": [{"text": "zz-drill-floor package", "hits": ["zz-drill-floor"]}]
    },
    {
      "id": "public-owner-overrides-inconsistent-user-row",
      "registry": {
        "zz-drill-mixed/one": {"owner_type": "User", "repo_id": 12, "full_name": "zz-drill-mixed/one"},
        "zz-drill-mixed/two": {"owner_type": "Organization", "repo_id": 13, "full_name": "zz-drill-mixed/two"}
      },
      "expected": {"handles": [], "stalePaths": [], "publicRepos": ["zz-drill-mixed/one", "zz-drill-mixed/two"]}
    },
    {
      "id": "external-encoded-former-owner",
      "registry": {"zz-drill-former/tool": {"owner_type": "User", "repo_id": 14, "full_name": "zz-drill-current/tool"}},
      "expected": {"handles": ["zz-drill-current", "zz-drill-former"], "stalePaths": ["zz-drill-former/tool"], "publicRepos": []},
      "projection": {"repo": "zz-drill-former/tool", "homepage": "https://example.invalid/%257A%257A-drill-former/tool", "expectedHomepage": null}
    },
    {
      "id": "template-word-former-owner-homepage",
      "registry": {"system/tool": {"owner_type": "User", "repo_id": 15, "full_name": "zz-drill-current/tool"}},
      "templateWords": ["system"],
      "expected": {"handles": ["system", "zz-drill-current"], "stalePaths": ["system/tool"], "publicRepos": []},
      "projection": {"repo": "system/tool", "homepage": "https://system.example/", "expectedHomepage": null}
    },
    {
      "id": "project-account-transfers-last-repository",
      "registry": {"zz-drill-project/tool": {"owner_type": "Organization", "repo_id": 16, "full_name": "zz-drill-lab/tool"}},
      "accounts": {"zz-drill-project": {}},
      "expected": {"handles": [], "stalePaths": [], "publicRepos": ["zz-drill-project/tool"]},
      "strictExpected": {"handles": ["zz-drill-project"], "stalePaths": ["zz-drill-project/tool"], "publicRepos": ["zz-drill-project/tool"]},
      "projection": {"repo": "zz-drill-project/tool", "homepage": "https://zz-drill-project.example/", "expectedHomepage": "https://zz-drill-project.example/"}
    },
    {
      "id": "dependency-package-token-boundaries",
      "registry": {
        "zz-drill-former/tool": {"owner_type": "User", "repo_id": 18, "full_name": "zz-drill-person/tool"},
        "zz-drill-lab/kept": {"owner_type": "Organization", "repo_id": 19, "full_name": "zz-drill-lab/kept"},
        "system/tool": {"owner_type": "User", "repo_id": 20, "full_name": "system/tool"},
        "zz-drill-lab/moved": {"owner_type": "User", "repo_id": 21, "full_name": "zzdrillfern/moved"},
        "zz-drill-lab/widget-zzdrillfern-plugin": {"owner_type": "Organization", "repo_id": 22, "full_name": "zz-drill-lab/widget-zzdrillfern-plugin"}
      },
      "templateWords": ["system"],
      "expected": {"handles": ["system", "zz-drill-former", "zz-drill-person", "zzdrillfern"], "stalePaths": ["zz-drill-former/tool", "zz-drill-lab/moved"], "publicRepos": ["zz-drill-lab/kept", "zz-drill-lab/widget-zzdrillfern-plugin"]},
      "publicPaths": ["zz-drill-lab/widget-zzdrillfern-plugin"],
      "probes": [
        {"text": "widget-zz-drill-person-plugin", "hits": []},
        {"text": "widget-zz-drill-person%61", "hits": []},
        {"text": "widget-zz-drill-former-plugin", "hits": []},
        {"text": "widget-zzdrillfern-plugin", "hits": []},
        {"text": "zz-drill-lab/widget-zzdrillfern-plugin", "hits": []},
        {"text": "https://github.com/zz-drill-lab/widget-zzdrillfern-plugin", "hits": []},
        {"text": "--zz-drill-person--", "hits": []},
        {"text": "widget-ZZ-DRILL-PERSON-plugin-zz-drill-former", "hits": []},
        {"text": "widget_zz-drill-person.plugin", "hits": ["zz-drill-person"]},
        {"text": "zz-drill-person zz-drill-former zzdrillfern", "hits": ["zz-drill-former", "zz-drill-person", "zzdrillfern"]}
      ],
      "dependencyProbes": [
        {"text": "widget-zz-drill-person-plugin", "hits": ["zz-drill-person"]},
        {"text": "widget-zz-drill-person%61", "hits": ["zz-drill-person"]},
        {"text": "widget-ZZ-DRILL-PERSON%2561", "hits": ["zz-drill-person"]},
        {"text": "widget-zz-drill-former-plugin", "hits": ["zz-drill-former"]},
        {"text": "widget-zzdrillfern-plugin", "hits": ["zzdrillfern"]},
        {"text": "widget-zz-drill-lab-plugin", "hits": []},
        {"text": "widget-system-plugin", "hits": []},
        {"text": "widget-zz-drill-personx-plugin widget-xzz-drill-person-plugin widget-zz-drill-person2-plugin", "hits": []},
        {"text": "widget_zz-drill-person.plugin", "hits": ["zz-drill-person"]},
        {"text": "--zz-drill-person--", "hits": ["zz-drill-person"]},
        {"text": "widget-zz--drill-person-plugin", "hits": []},
        {"text": "widget-ZZ-DRILL-PERSON-plugin-zz-drill-former", "hits": ["zz-drill-former", "zz-drill-person"]}
      ],
      "packages": [
        {"system": "npm", "package": "widget-zz-drill-person-plugin", "masked": true},
        {"system": "npm", "package": "widget-zz-drill-person%61", "masked": true},
        {"system": "npm", "package": "widget-ZZ-DRILL-PERSON%2561", "masked": true},
        {"system": "widget-zz-drill-person%61", "package": "widget", "masked": false, "systemMasked": true},
        {"system": "npm", "package": "widget-zz-drill-former-plugin", "masked": true},
        {"system": "npm", "package": "widget-zzdrillfern-plugin", "masked": true},
        {"system": "npm", "package": "widget-zz-drill-lab-plugin", "masked": false},
        {"system": "npm", "package": "widget-system-plugin", "masked": false},
        {"system": "npm", "package": "github.com/system/tool", "masked": true, "textMasked": true},
        {"system": "npm", "package": "widget-ZZ-DRILL-PERSON-plugin", "masked": true},
        {"system": "npm", "package": "widget%252Dzz-drill-person%252Dplugin", "masked": true},
        {"system": "npm", "package": "widget_zz-drill-person.plugin", "masked": true, "textMasked": true},
        {"system": "npm", "package": "--zz-drill-person--", "masked": true},
        {"system": "npm", "package": "widget---zz-drill-person---plugin", "masked": true},
        {"system": "npm", "package": "widget-zz--drill-person-plugin", "masked": false},
        {"system": "npm", "package": "widget-zz-drill-personx-plugin", "masked": false},
        {"system": "npm", "package": "widget-xzz-drill-person-plugin", "masked": false},
        {"system": "npm", "package": "widget-zz-drill-person2-plugin", "masked": false},
        {"system": "widget-zz-drill-person-plugin", "package": "widget", "masked": false, "systemMasked": true},
        {"system": "npm", "package": "zz-drill-person", "masked": true, "textMasked": true}
      ]
    },
    {
      "id": "out-of-range-html-decimal-reference",
      "registry": {"zz-drill-person/tool": {"owner_type": "User", "repo_id": 17, "full_name": "zz-drill-person/tool"}},
      "expected": {"handles": ["zz-drill-person"], "stalePaths": [], "publicRepos": []},
      "decimalEntities": [
        {"text": "&#1114112;", "decoded": "\u0000", "hits": []},
        {"text": "&#1114112; @zz-drill-person", "decoded": "\u0000 @zz-drill-person", "hits": ["zz-drill-person"]},
        {"text": "&#1114112; &#64;zz&#45;drill&#45;person", "decoded": "\u0000 @zz-drill-person", "hits": ["zz-drill-person"]},
        {"text": "&#9007199254740993;", "decoded": "\u0000", "hits": []}
      ]
    }
  ]
